R"TIDE_REVIEW(<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tide Motion — advisory review</title><style>
:root{color-scheme:dark;--background:#11151b;--foreground:#ecf0f5;--card:#1a222c;--border:#344352;--primary:#87c8ff;--radius:12px;--font-sans:system-ui,sans-serif}*{box-sizing:border-box}html,body{margin:0;color:var(--foreground);font:14px var(--font-sans)}main{display:grid;gap:14px}header,.panel{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px}h1{font-size:23px;margin:0 0 8px}h2{font-size:17px;margin:0 0 10px}p{line-height:1.5;margin:8px 0}button,select,input,textarea{font:inherit;color:inherit;background:var(--background);border:1px solid var(--border);border-radius:7px;padding:8px}button{cursor:pointer}button:hover{border-color:var(--primary)}button:disabled{opacity:.4;cursor:default}textarea{width:100%;min-height:65px;resize:vertical}label{display:inline-flex;gap:7px;align-items:center}.row{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.muted{opacity:.75}.layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,1fr);gap:14px}canvas{display:block;width:100%;height:350px;touch-action:none;background:#101820;border-radius:9px}input[type=range]{flex:1;min-width:160px;padding:0}.list{max-height:440px;overflow:auto;display:grid;gap:8px}.hint{padding:12px;background:var(--background);border:1px solid var(--border);border-radius:8px}.hint.selected{border-color:var(--primary)}.tag{color:var(--primary)}small{font-size:12px}.details{white-space:pre-wrap;overflow-wrap:anywhere}#status{min-height:20px;color:var(--primary)}.feedback{border-top:1px solid var(--border);padding-top:12px;margin-top:12px}.coverage{font-size:12px;line-height:1.6}.hint button{padding:5px 8px}.notice{color:#ffd89a}a{color:var(--primary)}@media(max-width:760px){.layout{grid-template-columns:1fr}canvas{height:300px}}
</style></head><body><main>
<header><h1 id="title">Tide motion review</h1><p>Watch the motion first, then reveal advisory observations. You decide which deserve attention. No observation is a quality verdict.</p><div class="row"><label>Case <select id="cases"></select></label><button id="previous">Previous</button><button id="next">Next</button><button id="export">Export feedback JSON</button><label>Import feedback <input id="import" type="file" accept="application/json,.json" style="max-width:190px"></label></div><p id="summary" class="muted">No assessments recorded yet.</p><p id="status" role="status">Feedback stays in this view. Export it before closing.</p></header>
<div class="layout"><section class="panel"><h2 id="caseTitle"></h2><canvas id="scene" aria-label="Animated body proxy in front and side views"></canvas><div class="row" style="margin-top:12px"><button id="play">Play</button><button id="back">−1 frame</button><button id="forward">+1 frame</button><label>Speed <select id="speed"><option value="0.25">¼×</option><option value="0.5">½×</option><option value="1" selected>1×</option></select></label></div><div class="row" style="margin-top:12px"><input id="scrub" type="range" min="0" value="0" aria-label="Animation frame"><output id="time"></output></div><div class="row" style="margin-top:12px"><label><input type="checkbox" id="follow" checked> Follow root</label><label><input type="checkbox" id="proxies"> Show analysis capsules</label><label><input type="checkbox" id="loopHint"> Loop selected interval</label></div><p class="muted">Blue: left · orange: right · yellow: selected observation. Two orthographic views. This is a skeleton/body-proxy viewer, not the original skinned character.</p><details><summary>Source and example context (may reveal the test treatment)</summary><p id="context" class="details"></p><p id="source" class="details muted"></p></details><details><summary>What was and was not evaluated</summary><p id="coverage" class="coverage"></p></details><div class="feedback"><h2>Your observations, including things the tool missed</h2><p class="muted">Pause or scrub to the relevant frame, describe what you notice, then add it. You can also record that you found nothing worth changing.</p><textarea id="newNote" aria-label="Your timestamped observation" placeholder="What needs attention, or what should stay intentional?"></textarea><div class="row"><button id="addNote">Add note at current frame</button><button id="nothing">Nothing I want changed</button></div><div id="notes"></div></div></section>
<section class="panel"><div class="row"><h2 style="flex:1">Advisory observations</h2><button id="reveal">Reveal hints</button></div><p id="hintIntro">Hints are hidden so you can form your own impression first.</p><div id="hints" class="list"></div><div id="rating" class="feedback" hidden><h2>Selected observation</h2><p id="selectedText"></p><label>Your assessment <select id="assessment"><option value="unreviewed">Unreviewed</option><option value="attention">Accurate — needs attention</option><option value="acceptable">Accurate — acceptable here</option><option value="intentional">Intentional — preserve it</option><option value="inaccurate">Inaccurate observation</option><option value="unsure">Unsure</option></select></label><textarea id="reason" aria-label="Reason or preferred change" placeholder="Why? What would you change or preserve?" style="margin-top:10px"></textarea><p class="muted">Ratings never remove the underlying measurement. No clip is modified.</p></div></section></div></main>
<script type="application/json" id="reviewData">__TIDE_REVIEW_DATA__</script><script>
'use strict';
const data=JSON.parse(document.getElementById('reviewData').textContent),$=id=>document.getElementById(id),canvas=$('scene'),ctx=canvas.getContext('2d');
let index=0,frame=0,selected=null,playing=false,clock=0,last=0;
const feedback={schemaVersion:1,purpose:'human-advisory-review',identity:data.identity,cases:{}};
const revealed=new Set();
const RULES={'local-rotation-step':'Local rotation step','forearm-torso-proxy-overlap':'Forearm / torso proxy overlap','foot-joint-below-plane':'Foot joint below reference plane','low-foot-horizontal-motion':'Horizontal motion near reference plane','prop-torso-proxy-overlap':'Prop / torso proxy overlap'};
function current(){return data.cases[index]}
function record(){const id=current().id;if(!Object.hasOwn(feedback.cases,id))Object.defineProperty(feedback.cases,id,{value:{observations:{},notes:[],overall:'unreviewed'},enumerable:true,writable:true,configurable:true});return feedback.cases[id]}
function summary(){const counts={attention:0,acceptable:0,intentional:0,inaccurate:0,unsure:0};let notes=0;for(const r of Object.values(feedback.cases)){notes+=r.notes.length;for(const v of Object.values(r.observations))if(Object.hasOwn(counts,v.assessment))counts[v.assessment]++}$('summary').textContent=`Your assessments: ${counts.attention} need attention · ${counts.acceptable} acceptable · ${counts.intentional} intentional · ${counts.inaccurate} inaccurate · ${counts.unsure} unsure · ${notes} personal notes`; }
function changed(){ summary();$('status').textContent='Feedback updated in this view. Export JSON to keep it.'; }
function element(tag,text){const e=document.createElement(tag);e.textContent=text;return e}
$('title').textContent=data.title;
data.cases.forEach((c,i)=>{const o=element('option',`${i+1}. ${c.label}`);o.value=i;$('cases').append(o)});
function setFrame(f){frame=Math.max(0,Math.min(current().frames-1,Math.round(f)));$('scrub').value=frame;$('time').textContent=`${(frame/current().fps).toFixed(3)} s · frame ${frame}/${current().frames-1}`;draw()}
function selectCase(i){index=Math.max(0,Math.min(data.cases.length-1,i));playing=false;$('play').textContent='Play';selected=null;$('rating').hidden=true;$('cases').value=index;$('caseTitle').textContent=current().label;$('scrub').max=current().frames-1;$('context').textContent=current().context||'No additional context.';$('source').textContent=JSON.stringify(current().source,null,2);$('coverage').replaceChildren();Object.entries(current().coverage).forEach(([k,v])=>$('coverage').append(element('div',`${k}: ${v}`)));$('previous').disabled=index===0;$('next').disabled=index===data.cases.length-1;showHints();showNotes();setFrame(0)}
function showHints(){const c=current(),visible=revealed.has(c.id);$('reveal').textContent=visible?'Hide hints':'Reveal hints';$('hints').replaceChildren();$('hintIntro').textContent=visible?`${c.observations.length} sampled observation intervals. No findings does not mean all checks passed.`:'Hints are hidden so you can form your own impression first.';
if(!visible){$('rating').hidden=true;return}
for(const h of c.observations){const box=element('div','');box.className='hint'+(selected?.id===h.id?' selected':'');const b=element('button',`${RULES[h.rule]||h.rule} · ${h.startSeconds.toFixed(2)}–${h.endSeconds.toFixed(2)} s`);b.onclick=()=>choose(h);box.append(b,element('p',h.subjects.join(' / ')));const rating=record().observations[h.id]?.assessment||'unreviewed';box.append(element('small',`Peak ${h.peakValue.toFixed(3)} ${h.unit} · ${rating}`));$('hints').append(box)}
}
function choose(h){selected=h;playing=false;$('play').textContent='Play';$('rating').hidden=false;$('selectedText').textContent=`${h.method}. Threshold ${h.threshold} ${h.unit}; peak at frame ${h.peakFrame}.`;const r=record().observations[h.id];$('assessment').value=r?.assessment||'unreviewed';$('reason').value=r?.note||'';setFrame(h.peakFrame);showHints()}
function saveRating(){if(!selected)return;record().observations[selected.id]={assessment:$('assessment').value,note:$('reason').value,rule:selected.rule,subjects:selected.subjects,startFrame:selected.startFrame,endFrame:selected.endFrame,peakFrame:selected.peakFrame};changed();showHints()}
function showNotes(){$('notes').replaceChildren();for(const n of record().notes){const p=element('p',`${n.seconds.toFixed(3)} s · frame ${n.frame}: ${n.text}`);const b=element('button','Go');b.onclick=()=>setFrame(n.frame);p.prepend(b);$('notes').append(p)}if(record().overall==='nothing-to-change')$('notes').append(element('p','Your assessment: nothing you want changed.'))}
function bounds(c,follow){let low=Infinity,high=-Infinity,r=.9;for(const p of c.positions){const origin=p[0];for(const q of p){low=Math.min(low,q[1]);high=Math.max(high,q[1]);r=Math.max(r,Math.abs(q[0]-(follow?origin[0]:0)),Math.abs(q[2]-(follow?origin[2]:0)))} }for(const p of c.props)for(let f=0;f<p.positions.length;f++)for(const q of p.positions[f]){const o=c.positions[f][0];low=Math.min(low,q[1]);high=Math.max(high,q[1]);r=Math.max(r,Math.abs(q[0]-(follow?o[0]:0)),Math.abs(q[2]-(follow?o[2]:0)))}return {low:Math.min(c.settings.groundY,low)-.12,high:high+.18,r:r+.15}}
const fit=new Map();
function draw(){const c=current();if(!c)return;const width=Math.max(280,canvas.clientWidth),height=canvas.clientHeight,dpr=window.devicePixelRatio||1;if(canvas.width!==Math.round(width*dpr)||canvas.height!==Math.round(height*dpr)){canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr)}ctx.setTransform(dpr,0,0,dpr,0,0);ctx.fillStyle='#101820';ctx.fillRect(0,0,width,height);const p=c.positions[frame],follow=$('follow').checked,key=index+':'+follow;if(!fit.has(key))fit.set(key,bounds(c,follow));const box=fit.get(key),highlight=revealed.has(c.id)&&selected&&frame>=selected.startFrame&&frame<=selected.endFrame?new Set(selected.subjects):new Set();
for(let view=0;view<2;view++){const w=width/2,cx=w*(view+.5),scale=Math.min((height-50)/(box.high-box.low),(w-25)/(2*box.r));const origin=follow?p[0]:[0,0,0],floor=height-25+(box.low-c.settings.groundY)*scale;const project=q=>[cx+((view===0?q[0]:q[2])-(view===0?origin[0]:origin[2]))*scale,height-25-(q[1]-box.low)*scale];ctx.save();ctx.beginPath();ctx.rect(view*w,0,w,height);ctx.clip();ctx.strokeStyle='#334654';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(view*w,floor);ctx.lineTo((view+1)*w,floor);ctx.stroke();for(let a=-20;a<=20;a++){const offset=follow?(view===0?origin[0]:origin[2]):0;const x=cx+(a*.25-offset% .25)*scale;ctx.beginPath();ctx.moveTo(x,floor);ctx.lineTo(x+10,floor+8);ctx.stroke()}
ctx.fillStyle='#b7c8d4';ctx.font='12px system-ui';ctx.fillText(view===0?'Front (world X / Y)':'Side (world Z / Y)',view*w+12,20);
const lines=[];for(let j=0;j<c.joints.length;j++){const joint=c.joints[j],parent=joint.parent;if(parent<0)continue;lines.push({j,parent,depth:view===0?p[j][2]:p[j][0]})}lines.sort((a,b)=>a.depth-b.depth);
for(const l of lines){const a=project(p[l.parent]),b=project(p[l.j]),name=c.joints[l.j].name;ctx.strokeStyle=highlight.has(name)?'#ffe17b':name.startsWith('Left')?'#80beff':name.startsWith('Right')?'#ffa06a':'#c4d2df';ctx.lineWidth=Math.max(2,scale*.025);ctx.lineCap='round';ctx.beginPath();ctx.moveTo(...a);ctx.lineTo(...b);ctx.stroke();ctx.beginPath();ctx.arc(...b,Math.max(2,scale*.018),0,Math.PI*2);ctx.fillStyle=ctx.strokeStyle;ctx.fill()}
if($('proxies').checked)for(const proxy of c.bodyProxies){const ia=c.joints.findIndex(j=>j.name===proxy.from),ib=c.joints.findIndex(j=>j.name===proxy.to);const a=project(p[ia]),b=project(p[ib]);ctx.strokeStyle='rgba(150,200,230,.22)';ctx.lineWidth=proxy.radius*2*scale;ctx.beginPath();ctx.moveTo(...a);ctx.lineTo(...b);ctx.stroke()}
for(const prop of c.props){const a=project(prop.positions[frame][0]),b=project(prop.positions[frame][1]);ctx.strokeStyle=highlight.has(prop.name)?'#ffe17b':'#a6e3b0';ctx.lineWidth=Math.max(3,prop.radius*2*scale);ctx.beginPath();ctx.moveTo(...a);ctx.lineTo(...b);ctx.stroke()}ctx.restore()}
ctx.strokeStyle='#344352';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(width/2,0);ctx.lineTo(width/2,height);ctx.stroke()}
$('cases').onchange=()=>selectCase(Number($('cases').value));$('previous').onclick=()=>selectCase(index-1);$('next').onclick=()=>selectCase(index+1);$('scrub').oninput=()=>{playing=false;$('play').textContent='Play';setFrame(Number($('scrub').value))};$('back').onclick=()=>setFrame(frame-1);$('forward').onclick=()=>setFrame(frame+1);$('follow').onchange=draw;$('proxies').onchange=draw;$('play').onclick=()=>{playing=!playing;clock=frame;last=performance.now();$('play').textContent=playing?'Pause':'Play'};
$('reveal').onclick=()=>{const id=current().id;if(revealed.has(id))revealed.delete(id);else revealed.add(id);showHints();draw()};$('assessment').onchange=saveRating;$('reason').oninput=saveRating;
$('addNote').onclick=()=>{const text=$('newNote').value.trim();if(!text)return;record().notes.push({frame,seconds:frame/current().fps,text,nearbyObservationIds:current().observations.filter(h=>Math.abs(h.peakFrame-frame)<=Math.round(current().fps*.5)||frame>=h.startFrame&&frame<=h.endFrame).map(h=>h.id)});$('newNote').value='';changed();showNotes()};$('nothing').onclick=()=>{record().overall='nothing-to-change';changed();showNotes()};
$('export').onclick=()=>{const blob=new Blob([JSON.stringify({...feedback,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'}),a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download='tide-review-feedback.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);$('status').textContent='Feedback export requested. Keep the JSON file for the agent or import it to resume.'};
$('import').onchange=async()=>{try{const file=$('import').files[0];if(!file)return;if(file.size>4*1024*1024)throw Error('Feedback exceeds 4 MiB');const f=JSON.parse(await file.text());if(f.schemaVersion!==1||f.purpose!==feedback.purpose||JSON.stringify(f.identity)!==JSON.stringify(data.identity)||!f.cases||Array.isArray(f.cases)||typeof f.cases!=='object')throw Error('Feedback belongs to a different review set or rules version');
const clean={};for(const c of data.cases){if(!Object.hasOwn(f.cases,c.id))continue;const r=f.cases[c.id];if(!r||typeof r!=='object'||!Array.isArray(r.notes)||r.notes.length>10000||!r.observations||typeof r.observations!=='object'||Array.isArray(r.observations)||!['unreviewed','nothing-to-change'].includes(r.overall))throw Error('Invalid case feedback');const observations={};for(const [id,v] of Object.entries(r.observations)){const h=c.observations.find(h=>h.id===id);if(!h||!v||!['unreviewed','attention','acceptable','intentional','inaccurate','unsure'].includes(v.assessment)||typeof v.note!=='string'||v.note.length>20000)throw Error('Invalid observation feedback');Object.defineProperty(observations,id,{value:{assessment:v.assessment,note:v.note,rule:h.rule,subjects:h.subjects,startFrame:h.startFrame,endFrame:h.endFrame,peakFrame:h.peakFrame},enumerable:true,writable:true,configurable:true})}
const notes=r.notes.map(n=>{if(!n||!Number.isInteger(n.frame)||n.frame<0||n.frame>=c.frames||typeof n.text!=='string'||n.text.length>20000)throw Error('Invalid timestamped note');return {frame:n.frame,seconds:n.frame/c.fps,text:n.text,nearbyObservationIds:c.observations.filter(h=>Math.abs(h.peakFrame-n.frame)<=Math.round(c.fps*.5)||n.frame>=h.startFrame&&n.frame<=h.endFrame).map(h=>h.id)}});Object.defineProperty(clean,c.id,{value:{observations,notes,overall:r.overall},enumerable:true,writable:true,configurable:true})}
feedback.cases=clean;summary();selected=null;$('rating').hidden=true;showHints();showNotes();draw();$('status').textContent='Feedback imported for this exact review set.'}catch(e){$('status').textContent='Import refused: '+e.message}finally{$('import').value=''}};
function tick(now){if(playing){const c=current();clock+=(now-last)/1000*c.fps*Number($('speed').value);let lo=0,hi=c.frames-1;if($('loopHint').checked&&selected&&revealed.has(c.id)){lo=Math.max(0,selected.startFrame-5);hi=Math.min(c.frames-1,selected.endFrame+5)}if(clock>hi||clock<lo)clock=lo;setFrame(Math.floor(clock))}last=now;requestAnimationFrame(tick)}
window.addEventListener('resize',draw);selectCase(0);requestAnimationFrame(tick);
</script></body></html>)TIDE_REVIEW"
