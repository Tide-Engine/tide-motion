file(MAKE_DIRECTORY "${WORK}/with spaces and 'quotes'")
set(work "${WORK}/with spaces and 'quotes'")
execute_process(COMMAND "${FIXTURE}" --fixtures "${work}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Cannot generate retarget fixtures")
endif()
file(WRITE "${work}/source.glb.json" "{\"protectedFrames\":[0]}")
execute_process(COMMAND "${TOOL}" inspect "${work}/target.glb" --skeleton RESULT_VARIABLE code OUTPUT_VARIABLE info)
if(NOT code EQUAL 0 OR NOT info MATCHES "Character:LeftForeArm")
  message(FATAL_ERROR "Cannot inspect character rig")
endif()
file(REMOVE "${work}/forward.glb" "${work}/forward.glb.json" "${work}/back.glb" "${work}/back.glb.json")
file(WRITE "${work}/jobs.json" "{\"actions\":[{\"action\":\"retarget\",\"source\":\"source.glb\",\"target\":\"target.glb\",\"map\":\"bones.json\",\"output\":\"forward.glb\"},{\"action\":\"retarget\",\"source\":\"forward.glb\",\"map\":\"bones.json\",\"toSoma\":true,\"output\":\"back.glb\"}]}")
execute_process(COMMAND "${TOOL}" batch "${work}/jobs.json" --models "${work}/no-models" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR "${out}${err}" MATCHES "Loading")
  message(FATAL_ERROR "Model-free retarget batch failed: ${out}${err}")
endif()
file(READ "${work}/back.glb.json" back_recipe)
string(JSON pin GET "${back_recipe}" protectedFrames 0)
if(NOT pin EQUAL 0)
  message(FATAL_ERROR "Retarget lost the authored frame protection")
endif()
execute_process(COMMAND "${TOOL}" inspect "${work}/back.glb" RESULT_VARIABLE code OUTPUT_VARIABLE info)
if(NOT code EQUAL 0 OR NOT info MATCHES "soma30")
  message(FATAL_ERROR "Reverse retarget output is not canonical SOMA")
endif()
file(REMOVE "${work}/no-cache.glb" "${work}/no-cache.glb.json")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=HOME --unset=LOCALAPPDATA --unset=XDG_CACHE_HOME --unset=TIDE_MOTION_MODELS "${TOOL}" retarget "${work}/source.glb" --target "${work}/target.glb" --map "${work}/bones.json" -o "${work}/no-cache.glb" RESULT_VARIABLE code ERROR_VARIABLE err)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Retarget unexpectedly needs a model-cache environment: ${err}")
endif()
execute_process(COMMAND "${TOOL}" retarget "${work}/source.glb" --target "${work}/target.glb" --map "${work}/bones.json" -o "${work}/forward.glb" RESULT_VARIABLE code ERROR_VARIABLE err)
if(code EQUAL 0 OR NOT err MATCHES "already exists")
  message(FATAL_ERROR "Retarget overwrote an existing asset")
endif()
# FBX characters: inspect, retarget onto one and preview on one (with a fake Tide,
# which fails only after the preview project is written).
execute_process(COMMAND "${TOOL}" inspect "${work}/target.fbx" --skeleton RESULT_VARIABLE code OUTPUT_VARIABLE info)
if(NOT code EQUAL 0 OR NOT info MATCHES "Character:LeftForeArm")
  message(FATAL_ERROR "Cannot inspect an FBX character rig: ${info}")
endif()
file(REMOVE "${work}/fbx.glb" "${work}/fbx.glb.json")
execute_process(COMMAND "${TOOL}" retarget "${work}/source.glb" --target "${work}/target.fbx" --map "${work}/bones.json" -o "${work}/fbx.glb" RESULT_VARIABLE code ERROR_VARIABLE err)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Cannot retarget onto an FBX rig: ${err}")
endif()
function(refuses match)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(code EQUAL 0 OR NOT "${out}${err}" MATCHES "${match}")
    message(FATAL_ERROR "Expected refusal '${match}' for ${ARGN}; got ${code}: ${out}${err}")
  endif()
endfunction()
set(ENV{TIDE_HIDDEN} 1)
refuses("Tide preview failed" preview "${work}/source.glb" --character "${work}/target.fbx" --map "${work}/bones.json" --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
refuses("Tide preview failed" preview "${work}/fbx.glb" --character "${work}/target.fbx" --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
refuses("Tide preview failed" preview "${work}/source.glb" --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
refuses("Give --map" preview "${work}/source.glb" --character "${work}/target.fbx" --capture "${work}/p.png")
refuses("leave out --map" preview "${work}/fbx.glb" --character "${work}/target.fbx" --map "${work}/bones.json" --capture "${work}/p.png")
refuses("go with --character" preview "${work}/source.glb" --map "${work}/bones.json" --capture "${work}/p.png")
refuses("one of --mannequin and --skeleton" preview "${work}/source.glb" --mannequin --skeleton --capture "${work}/p.png")
refuses("mannequin is SOMA-30" preview "${work}/fbx.glb" --mannequin --capture "${work}/p.png")
refuses("png or .jpg" preview "${work}/source.glb" --character "${work}/target.fbx" --map "${work}/bones.json" --texture "${work}/bones.json" --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
message(STATUS "Retarget inspect, batch, reverse, FBX, preview and output contracts pass")
