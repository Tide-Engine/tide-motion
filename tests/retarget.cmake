refuses("not a bone of the SOMA mannequin" preview "${work}/source.glb" --prop "${work}/prop.glb" --prop-bone "${hand}" --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
refuses("is not a bone of" preview "${work}/fbx.glb" --character "${work}/target.fbx" --prop "${work}/prop.glb" --prop-bone RightHand --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
refuses("needs --prop-bone" preview "${work}/source.glb" --prop "${work}/prop.glb" --capture "${work}/p.png")
