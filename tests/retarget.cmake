refuses("Tide preview failed" preview "${work}/source.glb" --setup "${work}/preview-setup.json" --frames 1 --tide "${CMAKE_COMMAND}")
refuses("already exists" preview "${work}/source.glb" --setup "${work}/preview-setup.json" --save-setup "${work}/preview-setup.json" --frames 1)
