file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURE}" "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Review fixture failed")
endif()
file(WRITE "${WORK}/review.json" "{\"version\":1,\"cases\":[{\"id\":\"fixture\",\"file\":\"fixture.glb\"}]}")
execute_process(COMMAND "${TOOL}" review "${WORK}/review.json" -o "${WORK}/review.html" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${WORK}/review.html.json")
  message(FATAL_ERROR "Native review failed")
endif()
file(READ "${WORK}/review.html.json" report)
string(JSON purpose GET "${report}" cases 0 purpose)
if(NOT purpose STREQUAL "advisory-observations")
  message(FATAL_ERROR "Missing advisory report contract")
endif()
file(SHA256 "${WORK}/review.html" before)
execute_process(COMMAND "${TOOL}" review "${WORK}/review.json" -o "${WORK}/review.html" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${WORK}/review.html" after)
if(result EQUAL 0 OR NOT before STREQUAL after)
  message(FATAL_ERROR "Existing report overwritten")
endif()
file(WRITE "${WORK}/bad.json" "{\"version\":1,\"cases\":[{\"id\":\"first\",\"file\":\"fixture.glb\"},{\"id\":\"late\",\"file\":\"missing.glb\"}]}")
execute_process(COMMAND "${TOOL}" review "${WORK}/bad.json" -o "${WORK}/bad.html" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0 OR EXISTS "${WORK}/bad.html" OR EXISTS "${WORK}/bad.html.json")
  message(FATAL_ERROR "Late source failure wrote partial review")
endif()
