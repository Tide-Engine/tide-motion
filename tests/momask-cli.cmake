file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${TOOL}" --help RESULT_VARIABLE status OUTPUT_VARIABLE help)
if(NOT status EQUAL 0 OR NOT help MATCHES "inpaint")
  message(FATAL_ERROR "MoMask help failed")
endif()
function(refuse expected)
  execute_process(COMMAND "${TOOL}" ${ARGN} --models "${WORK}/missing models"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "${expected}")
    message(FATAL_ERROR "MoMask preflight failed: ${ARGN}: ${error}")
  endif()
endfunction()
refuse("generation controls" generate "a person walks" -o "${WORK}/bad.glb" --steps 1)
refuse("generation controls" generate "   " -o "${WORK}/bad.glb")
refuse("ASCII" generate "a & b" -o "${WORK}/bad.glb")
refuse("integer" generate "walk" -o "${WORK}/bad.glb" --seed 1.5)
refuse("edit options" generate "walk" -o "${WORK}/bad.glb" --begin 2)
refuse("requires --source" inpaint "walk" -o "${WORK}/bad.glb")
refuse("Unknown MoMask option" generate "walk" -o "${WORK}/bad.glb" --path 1)
file(WRITE "${WORK}/preflight.json" "{\"schema\":1,\"jobs\":[{\"prompt\":\"walk\",\"output\":\"first.glb\"},{\"prompt\":\"walk\",\"output\":\"second.glb\",\"steps\":1}]}")
refuse("generation controls" batch "${WORK}/preflight.json")
file(WRITE "${WORK}/collision.json" "{\"schema\":1,\"jobs\":[{\"prompt\":\"walk\",\"output\":\"same.glb\"},{\"prompt\":\"idle\",\"output\":\"same.glb\"}]}")
refuse("collision" batch "${WORK}/collision.json")
file(WRITE "${WORK}/reserved.glb.part" "keep this partial file")
refuse("partial paths" generate "walk" -o "${WORK}/reserved.glb")
if(WIN32)
  file(WRITE "${WORK}/case-collision.json" "{\"schema\":1,\"jobs\":[{\"prompt\":\"walk\",\"output\":\"CASE.glb\"},{\"prompt\":\"idle\",\"output\":\"case.glb\"}]}")
  refuse("collision" batch "${WORK}/case-collision.json")
endif()
