if(NOT DEFINED DIRECTORY)
  message(FATAL_ERROR "Pass -DDIRECTORY=<package directory>")
endif()
file(GLOB archives "${DIRECTORY}/tide-motion-*.zip" "${DIRECTORY}/tide-motion-*.tar.gz")
list(LENGTH archives count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Expected one runtime archive, found ${count}")
endif()
foreach(archive IN LISTS archives)
  file(SHA256 "${archive}" digest)
  get_filename_component(name "${archive}" NAME)
  file(WRITE "${archive}.sha256" "${digest}  ${name}\n")
endforeach()
