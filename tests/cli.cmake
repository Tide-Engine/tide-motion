file(MAKE_DIRECTORY "${WORK}/with spaces and 'quotes'")
set(source "${WORK}/with spaces and 'quotes'/source.glb")
file(REMOVE "${source}" "${source}.part")
execute_process(COMMAND "${FIXTURE}" --fixture "${source}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Could not create authored fixture")
endif()
execute_process(COMMAND "${TOOL}" inspect "${source}" RESULT_VARIABLE code OUTPUT_VARIABLE info)
if(NOT code EQUAL 0 OR NOT info MATCHES "soma30")
  message(FATAL_ERROR "Cannot inspect a GLB in a path with spaces/quotes: ${info}")
endif()
function(refuses match)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(code EQUAL 0 OR NOT "${out}${err}" MATCHES "${match}")
    message(FATAL_ERROR "Expected refusal '${match}' for ${ARGN}; got ${code}: ${out}${err}")
  endif()
endfunction()
refuses("already exists" generate "A person walks" -o "${source}")
refuses("integer" generate "A person walks" --steps 1.5 -o "${WORK}/new.glb")
refuses("does not take" inspect "${source}" --tokens 8)
refuses("accept-licenses" models install bricks --models "${WORK}/empty-models")
refuses("Missing or incomplete" models check bricks --models "${WORK}/empty-models")
refuses("Missing value" generate "A person walks" --duration)
file(WRITE "${WORK}/bad-batch.json" "{\"actions\":[{\"action\":\"generate\",\"prompt\":\"walk\",\"output\":\"new.glb\"},{\"action\":\"typo\",\"output\":\"other.glb\"}]}")
refuses("Batch action 2" batch "${WORK}/bad-batch.json")
if(EXISTS "${WORK}/new.glb")
  message(FATAL_ERROR "Batch executed before complete manifest preflight")
endif()
function(help_lists match)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0 OR NOT "${out}" MATCHES "${match}")
    message(FATAL_ERROR "Expected '${match}' in help for ${ARGN}; got ${code}: ${out}${err}")
  endif()
endfunction()
help_lists("--then.*--transition.*--start-pose.*--end-pose.*--keyframe.*--effector.*--path.*--gif.*help \\[COMMAND\\]" --help)
help_lists("--start-pose.*--end-pose.*--keyframe.*--effector.*--path.*--placement.*--no-correction" generate --help)
help_lists("--gif.*nightly.45" help preview)
help_lists("--to-soma.*--map" retarget -h)
help_lists("--skeleton" inspect --help)
# Constraints are resolved before any model is checked or loaded.
set(empty "${WORK}/empty-models")
refuses("has no frame 20" generate "A person walks" --start-pose "${source}@20" -o "${WORK}/new.glb" --models "${empty}")
refuses("outside the 90-frame output" generate "A person walks" --keyframe 100 "${source}" -o "${WORK}/new.glb" --models "${empty}")
refuses("outside the 180-frame output" generate "A" --then "B" --keyframe -181 "${source}@last" -o "${WORK}/new.glb" --models "${empty}")
refuses("Unknown effector" generate "A person walks" --effector nose 3 "${source}" -o "${WORK}/new.glb" --models "${empty}")
refuses("transition must be shorter" generate "A" --then "B" --duration 0.2 --transition 10 -o "${WORK}/new.glb" --models "${empty}")
refuses("Use --path" generate "A person walks" --path "1@3" -o "${WORK}/new.glb" --models "${empty}")
refuses("auto, world or free" generate "A person walks" --placement up -o "${WORK}/new.glb" --models "${empty}")
file(WRITE "${WORK}/bad-placement.json" "{\"actions\":[{\"action\":\"generate\",\"prompt\":\"walk\",\"placement\":\"up\",\"output\":\"new.glb\"}]}")
refuses("auto, world or free" batch "${WORK}/bad-placement.json" --models "${empty}")
refuses("share output frame" generate "A person walks" --start-pose "${source}" --keyframe 0 "${source}" -o "${WORK}/new.glb" --models "${empty}")
refuses("does not take" connect "${source}" "${source}" --start-pose "${source}" -o "${WORK}/new.glb")
refuses("Missing or incomplete" generate "A" --duration 1 --then "B" --start-pose "${source}" --end-pose "${source}@first" --keyframe 15 "${source}@-2" --effector left-hand,right-foot 20 "${source}" --path "0.5,-1,90@-5" -o "${WORK}/new.glb" --models "${empty}")
file(WRITE "${WORK}/both-prompts.json" "{\"actions\":[{\"action\":\"generate\",\"prompt\":\"walk\",\"prompts\":[{\"prompt\":\"run\"}],\"output\":\"new.glb\"}]}")
refuses("not both" batch "${WORK}/both-prompts.json" --models "${empty}")
file(WRITE "${WORK}/bad-effector.json" "{\"actions\":[{\"action\":\"generate\",\"prompt\":\"walk\",\"effectors\":[{\"effectors\":[\"left-hand\",\"tail\"],\"frame\":3,\"file\":\"source.glb\"}],\"output\":\"new.glb\"}]}")
refuses("Unknown effector" batch "${WORK}/bad-effector.json" --models "${empty}")
file(WRITE "${WORK}/with spaces and 'quotes'/constrained.json" "{\"actions\":[{\"action\":\"generate\",\"prompts\":[{\"prompt\":\"walk\",\"duration\":1},{\"prompt\":\"wave\",\"duration\":1}],\"transition\":4,\"startPose\":\"source.glb\",\"endPose\":{\"file\":\"source.glb\",\"frame\":0},\"keyframes\":[{\"frame\":30,\"file\":\"source.glb\",\"sourceFrame\":-1}],\"effectors\":[{\"effectors\":\"right-hand\",\"frame\":40,\"file\":\"source.glb\"}],\"path\":[{\"frame\":50,\"x\":1,\"z\":2,\"yaw\":45}],\"placement\":\"world\",\"correct\":false,\"output\":\"constrained.glb\"}]}")
refuses("Missing or incomplete" batch "${WORK}/with spaces and 'quotes'/constrained.json" --models "${empty}")
if(EXISTS "${WORK}/new.glb" OR EXISTS "${WORK}/with spaces and 'quotes'/constrained.glb")
  message(FATAL_ERROR "Generation ran without models")
endif()
refuses("nightly.45" preview "${source}" --gif "${WORK}/preview.gif" --tide "${CMAKE_COMMAND}")
refuses("needs a .gif" preview "${source}" --gif "${WORK}/preview.png")
file(WRITE "${WORK}/malformed.glb" "not a GLB")
refuses("Malformed GLB" inspect "${WORK}/malformed.glb")
set(ENV{TIDE_HIDDEN} 1)
refuses("requires --capture, --gif or --frames" preview "${source}")
message(STATUS "CLI asset, argument and hidden-preview contracts pass")
