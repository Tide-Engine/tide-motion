+// Sparse conditioning over the whole output timeline (Tide Motion patch).
+// observed and mask are [frames, motion_dim()] unnormalized motion-representation
+// features, as built by upstream create_conditions: smooth root (x, y, z),
+// heading (cos, sin), root-relative joint positions, global cont6d rotations,
+// velocities and foot contacts. mask holds 0 or 1 per feature. first_heading is
+// the heading of frame 0 in radians (upstream first_heading_angle).
+struct motion_condition {
+    std::vector<float> observed;
+    std::vector<float> mask;
+    float first_heading = 0.f;
+};
