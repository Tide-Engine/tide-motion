file(MAKE_DIRECTORY "${WORK}/with spaces and 'quotes'")
set(work "${WORK}/with spaces and 'quotes'")
execute_process(COMMAND "${FIXTURE}" --fixtures "${work}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Cannot generate retarget fixtures")
endif()
execute_process(COMMAND "${TOOL}" inspect "${work}/target.glb" --skeleton RESULT_VARIABLE code OUTPUT_VARIABLE info)
if(NOT code EQUAL 0 OR NOT info MATCHES "Character:LeftForeArm")
  message(FATAL_ERROR "Cannot inspect character rig")
endif()
file(REMOVE "${work}/forward.glb" "${work}/forward.glb.json" "${work}/back.glb" "${work}/back.glb.json")
file(WRITE "${work}/jobs.json" "{\"actions\":[{\"action\":\"retarget\",\"source\":\"source.glb\",\"target\":\"target.glb\",\"map\":\"bones.json\",\"output\":\"forward.glb\"},{\"action\":\"retarget\",\"source\":\"forward.glb\",\"map\":\"bones.json\",\"toSoma\":true,\"output\":\"back.glb\"}]}")
execute_process(COMMAND "${TOOL}" batch "${work}/jobs.json" --models "${work}/no-models" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 0 OR "${out}${err}" MATCHES "Loading")
  message(FATAL_ERROR "Model-free retarget batch failed: ${out}${err}")
endif()
execute_process(COMMAND "${TOOL}" inspect "${work}/back.glb" RESULT_VARIABLE code OUTPUT_VARIABLE info)
if(NOT code EQUAL 0 OR NOT info MATCHES "soma30")
  message(FATAL_ERROR "Reverse retarget output is not canonical SOMA")
endif()
file(REMOVE "${work}/no-cache.glb" "${work}/no-cache.glb.json")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=HOME --unset=LOCALAPPDATA --unset=XDG_CACHE_HOME --unset=TIDE_MOTION_MODELS "${TOOL}" retarget "${work}/source.glb" --target "${work}/target.glb" --map "${work}/bones.json" -o "${work}/no-cache.glb" RESULT_VARIABLE code ERROR_VARIABLE err)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Retarget unexpectedly needs a model-cache environment: ${err}")
endif()
execute_process(COMMAND "${TOOL}" retarget "${work}/source.glb" --target "${work}/target.glb" --map "${work}/bones.json" -o "${work}/forward.glb" RESULT_VARIABLE code ERROR_VARIABLE err)
if(code EQUAL 0 OR NOT err MATCHES "already exists")
  message(FATAL_ERROR "Retarget overwrote an existing asset")
endif()
message(STATUS "Retarget inspect, batch, reverse and output contracts pass")
