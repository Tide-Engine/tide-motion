+namespace {
+// The last four body features are the foot contacts; undo the body normalization.
+std::vector<float> foot_contacts(std::span<const float> normalized, size_t frames, const detail::skeleton_spec &skeleton,
+                                 std::span<const float> body_mean, std::span<const float> body_std) {
+    const size_t motion_dim = skeleton.motion_dim(), body_dim = skeleton.body_dim();
+    std::vector<float> out(frames * 4);
+    if (normalized.size() != frames * motion_dim || body_mean.size() != body_dim || body_std.size() != body_dim) return {};
+    for (size_t f = 0; f < frames; ++f)
+        for (size_t k = 0; k < 4; ++k) {
+            const size_t d = body_dim - 4 + k;
+            out[f * 4 + k] = normalized[f * motion_dim + 5 + d] * std::sqrt(body_std[d] * body_std[d] + 1.e-5F) + body_mean[d];
+        }
+    return out;
+}
+}
