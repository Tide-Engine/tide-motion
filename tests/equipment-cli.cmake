file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${FIXTURE}" "${WORK}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Equipment fixtures failed")
endif()
function(run_ok)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Equipment command failed: ${ARGN}: ${out}${err}")
  endif()
endfunction()
function(refuses match)
  execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(code EQUAL 0 OR NOT "${out}${err}" MATCHES "${match}")
    message(FATAL_ERROR "Expected ${match}: ${ARGN}: ${code}: ${out}${err}")
  endif()
endfunction()
set(ENV{TIDE_HIDDEN} 1)
file(REMOVE "${WORK}/baked.glb" "${WORK}/baked.glb.json" "${WORK}/body-only.glb" "${WORK}/body-only.glb.json" "${WORK}/report.json" "${WORK}/batch.glb" "${WORK}/batch.glb.json" "${WORK}/batch-body.glb" "${WORK}/batch-body.glb.json")
run_ok(equipment inspect "${WORK}/body.glb" --plan "${WORK}/plan.json" --report "${WORK}/report.json")
run_ok(equipment bake "${WORK}/body.glb" --plan "${WORK}/plan.json" -o "${WORK}/baked.glb" --body-output "${WORK}/body-only.glb" --strict)
run_ok(inspect "${WORK}/body-only.glb")
refuses("already exists" equipment bake "${WORK}/body.glb" --plan "${WORK}/plan.json" -o "${WORK}/baked.glb")
refuses("already exists" equipment inspect "${WORK}/body.glb" --plan "${WORK}/plan.json" --report "${WORK}/report.json")
refuses("Unknown equipment field" equipment inspect "${WORK}/body.glb" --plan "${WORK}/bad.json")
file(READ "${WORK}/plan.json" strict_plan)
string(JSON strict_plan SET "${strict_plan}" grips "[{\"name\":\"miss\",\"object\":\"sword\",\"bone\":\"LeftHand\",\"start\":0,\"end\":4}]")
file(WRITE "${WORK}/strict-plan.json" "${strict_plan}")
refuses("strict validation failed" equipment bake "${WORK}/body.glb" --plan "${WORK}/strict-plan.json" -o "${WORK}/strict.glb" --strict)
if(EXISTS "${WORK}/strict.glb" OR EXISTS "${WORK}/strict.glb.json")
  message(FATAL_ERROR "Strict refusal left outputs")
endif()
refuses("preview only" equipment inspect "${WORK}/body.glb" --plan "${WORK}/plan.json" --first-person)
refuses("differ from" equipment bake "${WORK}/body.glb" --plan "${WORK}/plan.json" -o "${WORK}/collision.glb" --report "${WORK}/collision.glb.json")
if(EXISTS "${WORK}/collision.glb")
  message(FATAL_ERROR "Collision refusal left an output")
endif()
file(WRITE "${WORK}/batch.json" "{\"actions\":[{\"action\":\"equipment\",\"source\":\"body.glb\",\"plan\":\"plan.json\",\"strict\":true,\"bodyOutput\":\"batch-body.glb\",\"output\":\"batch.glb\"}]}")
run_ok(batch "${WORK}/batch.json" --models "${WORK}/no-models")
run_ok(inspect "${WORK}/batch-body.glb")
file(READ "${WORK}/baked.glb.json" recipe)
string(JSON root GET "${recipe}" report objectTrajectoryBasis)
if(NOT root STREQUAL "source-body-before-grip-correction")
  message(FATAL_ERROR "Equipment recipe lost trajectory contract")
endif()
# Run without a cache environment: this path is entirely model-free.
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=HOME --unset=LOCALAPPDATA --unset=XDG_CACHE_HOME --unset=TIDE_MOTION_MODELS
  "${TOOL}" equipment inspect "${WORK}/body.glb" --plan "${WORK}/plan.json" RESULT_VARIABLE code OUTPUT_QUIET)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Equipment unexpectedly depends on model-cache discovery")
endif()
