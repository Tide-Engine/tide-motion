refuses("Use --prop-rotation X,Y,Z" preview "${work}/source.glb" --prop "${work}/prop.glb" --prop-bone RightHand --prop-rotation "0,90" --capture "${work}/p.png")
refuses("glb or .fbx mesh" preview "${work}/source.glb" --prop "${work}/bones.json" --prop-bone RightHand --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
# Each repeated prop has its own bone/transform; no bone leaks into the next group.
refuses("Tide preview failed" preview "${work}/source.glb" --prop "${work}/prop.glb" --prop-bone RightHand --prop-offset "0,0.1,0" --prop-rotation "0,90,0" --prop "${work}/prop.fbx" --prop-bone LeftHand --prop-offset "0.2,0,0" --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
refuses("needs --prop-bone" preview "${work}/source.glb" --prop "${work}/prop.glb" --prop-bone RightHand --prop "${work}/prop.glb" --capture "${work}/p.png")
refuses("is not a bone of" preview "${work}/source.glb" --prop "${work}/prop.glb" --prop-bone RightHand --prop "${work}/prop.glb" --prop-bone MissingHand --capture "${work}/p.png")
refuses("glb or .fbx mesh" preview "${work}/source.glb" --prop "${work}/prop.glb" --prop-bone RightHand --prop "${work}/bones.json" --prop-bone LeftHand --capture "${work}/p.png" --tide "${CMAKE_COMMAND}")
# First-person camera options and versioned equipment setups are validated before Tide.
refuses("Camera options go with" preview "${work}/source.glb" --camera-fov 90 --frames 1)
refuses("Camera bone not found" preview "${work}/source.glb" --first-person --camera-bone Missing --frames 1)
refuses("First-person preview needs" preview "${work}/source.glb" --first-person --skeleton --frames 1)
